{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lembrago",
  "version": "0.8.0",
  "identifier": "com.lembrago.app",
  "build": {
    "beforeDevCommand": "pnpm go:build:windows && pnpm go:build:linux && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm go:build:windows && pnpm go:build:linux && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "skipTaskbar": false,
        "maximized": false,
        "width": 320,
        "height": 340,
        "minHeight": 340
        
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin":["../go_modules/argo2id_generate/lembrago"]
  },
  "plugins": {
    "tauri": {
      "store": true
    },
    "updater": {
      "dangerousInsecureTransportProtocol": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGQ0Y1MzIyMDcwM0REMDkKUldRSjNRTUhJbFBQNzkwYlNJcEp1MGJ3WDRIcXNUdHh5ZWdXNllxUm9lUkFub0JaVjVOUHVjeksK",
      "endpoints": [
        "http://217.196.60.110:7888/versions/latest"
      ]
    }
  }

}
